@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix densho: <https://github.com/jlm0/densho/schema/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
dcterms:source a owl:DatatypeProperty ;
	rdfs:label "sources" ;
	rdfs:range _:c14n98 ;
	skos:definition "The URLs, repository paths, or citations that support the entity." ;
	skos:inScheme densho:metamodel .
rdf:type a owl:DatatypeProperty ;
	rdfs:label "kind" ;
	rdfs:range xsd:anyURI ;
	skos:definition "The class of the entity. The value is the class CURIE, for example densho:Concept." ;
	skos:inScheme densho:metamodel .
skos:Concept a owl:Class ;
	rdfs:label "TaxonomyNode" ;
	rdfs:subClassOf densho:KnowledgeNode , _:c14n102 , _:c14n86 , _:c14n90 ;
	skos:definition "A node in the classification from domain to concept." ;
	skos:exactMatch densho:TaxonomyNode ;
	skos:inScheme densho:metamodel .
skos:broader a owl:ObjectProperty ;
	rdfs:label "broader" ;
	rdfs:range skos:Concept ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The broader nodes in the taxonomy." ;
	skos:inScheme densho:metamodel .
skos:definition a owl:DatatypeProperty ;
	rdfs:label "definition" ;
	rdfs:range _:c14n106 ;
	skos:definition "The meaning of the node." ;
	skos:inScheme densho:metamodel .
skos:prefLabel a owl:DatatypeProperty ;
	rdfs:label "title" ;
	rdfs:range _:c14n63 ;
	skos:definition "The preferred name of the node." ;
	skos:inScheme densho:metamodel .
skos:related a owl:ObjectProperty , owl:SymmetricProperty ;
	rdfs:label "related" ;
	rdfs:range skos:Concept ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The nodes with an association to this node. This edge is symmetric." ;
	skos:inScheme densho:metamodel .
densho:AlwaysPointer a owl:Class ;
	rdfs:label "AlwaysPointer" ;
	rdfs:subClassOf densho:Pointer ;
	skos:definition "A pointer to a node that the harness loads at session start." ;
	skos:inScheme densho:metamodel .
densho:Basis\#judgment a owl:Class ;
	rdfs:label "judgment" ;
	rdfs:subClassOf densho:Basis ;
	skos:definition "No source supports the directive." .
densho:Basis\#practitioner a owl:Class ;
	rdfs:label "practitioner" ;
	rdfs:subClassOf densho:Basis ;
	skos:definition "A method of a named author or company." .
densho:Basis\#research a owl:Class ;
	rdfs:label "research" ;
	rdfs:subClassOf densho:Basis ;
	skos:definition "An empirical study or a model from research." .
densho:Basis\#standard a owl:Class ;
	rdfs:label "standard" ;
	rdfs:subClassOf densho:Basis ;
	skos:definition "A published standard or a versioned specification." .
densho:Basis a owl:Class ;
	rdfs:label "Basis" ;
	owl:unionOf _:c14n51 ;
	skos:definition "The kinds of source that support a directive." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:Basis\#judgment , densho:Basis\#practitioner , densho:Basis\#research , densho:Basis\#standard .
densho:CompiledResult\#in_force a owl:Class ;
	rdfs:label "in_force" ;
	rdfs:subClassOf densho:CompiledResult ;
	skos:definition "The graph holds only the accepted directives and exceptions." .
densho:CompiledResult\#proposals a owl:Class ;
	rdfs:label "proposals" ;
	rdfs:subClassOf densho:CompiledResult ;
	skos:definition "The graph also holds the proposed directives and exceptions, which are not in force." .
densho:CompiledResult a owl:Class ;
	rdfs:label "CompiledResult" ;
	owl:unionOf _:c14n94 ;
	skos:definition "The kinds of compiled graph." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:CompiledResult\#in_force , densho:CompiledResult\#proposals .
densho:Concept a owl:Class ;
	rdfs:label "Concept" ;
	rdfs:subClassOf skos:Concept , _:c14n103 , _:c14n27 ;
	skos:definition "A principle, a technique, or a body of knowledge." ;
	skos:inScheme densho:metamodel .
densho:Directive a owl:Class ;
	rdfs:label "Directive" ;
	rdfs:subClassOf densho:GovernedEntity , _:c14n13 , _:c14n16 , _:c14n18 , _:c14n91 ;
	skos:definition "An atomic instruction with its own identity. A directive lives in the file of one node." ;
	skos:inScheme densho:metamodel .
densho:DirectiveException a owl:Class ;
	rdfs:label "DirectiveException" ;
	rdfs:subClassOf _:c14n25 , _:c14n34 , _:c14n55 , _:c14n66 , _:c14n74 , _:c14n81 ;
	skos:definition "A statement that a node steps out of a directive that it would otherwise inherit. Only an accepted exception stops the directive." ;
	skos:inScheme densho:metamodel .
densho:DirectiveScope\#node a owl:Class ;
	rdfs:label "node" ;
	rdfs:subClassOf densho:DirectiveScope ;
	skos:definition "The directive applies only to the nodes that it attaches to and to each skill that uses one of them." .
densho:DirectiveScope\#subtree a owl:Class ;
	rdfs:label "subtree" ;
	rdfs:subClassOf densho:DirectiveScope ;
	skos:definition "The directive applies to the attached nodes and to each node under them. Each node is under the root. A skill is under each node that it uses." .
densho:DirectiveScope a owl:Class ;
	rdfs:label "DirectiveScope" ;
	owl:unionOf _:c14n87 ;
	skos:definition "The nodes that a directive applies to." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:DirectiveScope\#node , densho:DirectiveScope\#subtree .
densho:Discipline a owl:Class ;
	rdfs:label "Discipline" ;
	rdfs:subClassOf skos:Concept , _:c14n7 , _:c14n97 ;
	skos:definition "A field of work in a domain." ;
	skos:inScheme densho:metamodel .
densho:Domain a owl:Class ;
	rdfs:label "Domain" ;
	rdfs:subClassOf skos:Concept ;
	skos:definition "The top level of the taxonomy. A domain has no broader node." ;
	skos:inScheme densho:metamodel .
densho:GovernedEntity a owl:Class ;
	rdfs:label "GovernedEntity" ;
	rdfs:subClassOf _:c14n11 , _:c14n23 , _:c14n28 , _:c14n38 , _:c14n41 , _:c14n45 , _:c14n52 , _:c14n85 ;
	skos:definition "An addressable entity that governance tracks." ;
	skos:inScheme densho:metamodel .
densho:Invocation\#agent a owl:Class ;
	rdfs:label "agent" ;
	rdfs:subClassOf densho:Invocation ;
	skos:definition "The agent can start the skill by itself." .
densho:Invocation\#person a owl:Class ;
	rdfs:label "person" ;
	rdfs:subClassOf densho:Invocation ;
	skos:definition "Only a person starts the skill. The agent does not start it by itself." .
densho:Invocation a owl:Class ;
	rdfs:label "Invocation" ;
	owl:unionOf _:c14n56 ;
	skos:definition "The actors that can start a skill." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:Invocation\#agent , densho:Invocation\#person .
densho:KnowledgeGraph a owl:Class ;
	rdfs:label "KnowledgeGraph" ;
	rdfs:subClassOf _:c14n105 , _:c14n46 , _:c14n6 ;
	skos:definition "The root and the knowledge nodes of one repository. A graph has exactly one root." ;
	skos:inScheme densho:metamodel .
densho:KnowledgeNode a owl:Class ;
	rdfs:label "KnowledgeNode" ;
	rdfs:subClassOf densho:Node , _:c14n37 , _:c14n50 ;
	skos:definition "A node that holds domain knowledge or workspace knowledge." ;
	skos:inScheme densho:metamodel .
densho:KnowledgeType\#domain a owl:Class ;
	rdfs:label "domain" ;
	rdfs:subClassOf densho:KnowledgeType ;
	skos:definition "Universal knowledge." .
densho:KnowledgeType\#workspace a owl:Class ;
	rdfs:label "workspace" ;
	rdfs:subClassOf densho:KnowledgeType ;
	skos:definition "Knowledge that is specific to one project." .
densho:KnowledgeType a owl:Class ;
	rdfs:label "KnowledgeType" ;
	owl:unionOf _:c14n44 ;
	skos:definition "The kinds of knowledge." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:KnowledgeType\#domain , densho:KnowledgeType\#workspace .
densho:Node a owl:Class ;
	rdfs:label "Node" ;
	rdfs:subClassOf densho:GovernedEntity , _:c14n0 , _:c14n101 , _:c14n19 , _:c14n68 , _:c14n75 , _:c14n96 ;
	skos:definition "One file in the graph. A node holds its knowledge, its directives, and its pointers." ;
	skos:inScheme densho:metamodel .
densho:Origin\#project a owl:Class ;
	rdfs:label "project" ;
	rdfs:subClassOf densho:Origin ;
	skos:definition "The project added the entity." .
densho:Origin\#template a owl:Class ;
	rdfs:label "template" ;
	rdfs:subClassOf densho:Origin ;
	skos:definition "The template supplied the entity." .
densho:Origin a owl:Class ;
	rdfs:label "Origin" ;
	owl:unionOf _:c14n21 ;
	skos:definition "The sources of an entity." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:Origin\#project , densho:Origin\#template .
densho:PathPointer a owl:Class ;
	rdfs:label "PathPointer" ;
	rdfs:subClassOf densho:Pointer , _:c14n42 , _:c14n49 ;
	skos:definition "A pointer to a node that the harness loads when the agent opens a matching file." ;
	skos:inScheme densho:metamodel .
densho:Pointer a owl:Class ;
	rdfs:label "Pointer" ;
	rdfs:subClassOf _:c14n17 , _:c14n22 , _:c14n24 , _:c14n47 , _:c14n57 ;
	skos:definition "A route that tells an agent when and how to load a node." ;
	skos:inScheme densho:metamodel .
densho:PracticeArea a owl:Class ;
	rdfs:label "PracticeArea" ;
	rdfs:subClassOf skos:Concept , _:c14n59 , _:c14n80 ;
	skos:definition "A narrower area of work." ;
	skos:inScheme densho:metamodel .
densho:Root a owl:Class ;
	rdfs:label "Root" ;
	rdfs:subClassOf densho:Node , _:c14n31 ;
	skos:definition "The top node of the graph. Agents load the root first." ;
	skos:inScheme densho:metamodel .
densho:Skill a owl:Class ;
	rdfs:label "Skill" ;
	rdfs:subClassOf densho:KnowledgeNode , _:c14n1 , _:c14n12 , _:c14n71 ;
	skos:definition "A reusable capability that composes knowledge from any branch of the taxonomy." ;
	skos:inScheme densho:metamodel .
densho:SkillPointer a owl:Class ;
	rdfs:label "SkillPointer" ;
	rdfs:subClassOf densho:Pointer , _:c14n62 , _:c14n8 ;
	skos:definition "A pointer to a skill that the agent selects from the skill listing." ;
	skos:inScheme densho:metamodel .
densho:Status\#accepted a owl:Class ;
	rdfs:label "accepted" ;
	rdfs:subClassOf densho:Status ;
	skos:definition "A reviewer approved the entity. An accepted directive or exception is in force." .
densho:Status\#deprecated a owl:Class ;
	rdfs:label "deprecated" ;
	rdfs:subClassOf densho:Status ;
	skos:definition "The entity stays for reference. Do not apply it to new work." .
densho:Status\#proposed a owl:Class ;
	rdfs:label "proposed" ;
	rdfs:subClassOf densho:Status ;
	skos:definition "An author recommends the entity. No reviewer approved it. A proposed directive or exception is not in force." .
densho:Status\#rejected a owl:Class ;
	rdfs:label "rejected" ;
	rdfs:subClassOf densho:Status ;
	skos:definition "A person rejected the proposal. A rejected entity is not in force, and no generated file holds it." .
densho:Status a owl:Class ;
	rdfs:label "Status" ;
	owl:unionOf _:c14n30 ;
	skos:definition "The lifecycle states." ;
	skos:inScheme densho:metamodel ;
	linkml:permissible_values densho:Status\#accepted , densho:Status\#deprecated , densho:Status\#proposed , densho:Status\#rejected .
densho:TextPointer a owl:Class ;
	rdfs:label "TextPointer" ;
	rdfs:subClassOf densho:Pointer ;
	skos:definition "A pointer to a node that the agent opens when it reads the pointer text." ;
	skos:inScheme densho:metamodel .
densho:also_attached_to a owl:ObjectProperty ;
	rdfs:label "also_attached_to" ;
	rdfs:range densho:Node ;
	skos:definition "The nodes that the directive attaches to, in addition to the node that holds it." ;
	skos:inScheme densho:metamodel .
densho:applies a owl:ObjectProperty ;
	rdfs:label "applies" ;
	rdfs:range densho:Directive ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The directives that the skill applies." ;
	skos:inScheme densho:metamodel .
densho:basis a owl:ObjectProperty ;
	rdfs:label "basis" ;
	rdfs:range densho:Basis ;
	skos:definition "The kind of source that supports the directive." ;
	skos:inScheme densho:metamodel .
densho:body a owl:DatatypeProperty ;
	rdfs:label "body" ;
	rdfs:range _:c14n99 ;
	skos:definition "The supporting prose of the node." ;
	skos:inScheme densho:metamodel .
densho:conflicts_with a owl:ObjectProperty , owl:SymmetricProperty ;
	rdfs:label "conflicts_with" ;
	rdfs:range densho:Directive ;
	skos:definition "The directives that must not apply at the same node as this directive. This relationship is symmetric." ;
	skos:inScheme densho:metamodel .
densho:depends_on a owl:ObjectProperty ;
	rdfs:label "depends_on" ;
	rdfs:range skos:Concept ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The nodes that this node cannot exist without. A handoff from one step to the next uses informs." ;
	skos:inScheme densho:metamodel .
densho:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	rdfs:range _:c14n36 ;
	skos:definition "The text that an agent reads to select the skill." ;
	skos:inScheme densho:metamodel .
densho:directive a owl:ObjectProperty ;
	rdfs:label "directive" ;
	rdfs:range densho:Directive ;
	skos:definition "The directive that the exception stops." ;
	skos:inScheme densho:metamodel .
densho:directives a owl:ObjectProperty ;
	rdfs:label "directives" ;
	rdfs:range densho:Directive ;
	skos:definition "The directives that live in this file." ;
	skos:inScheme densho:metamodel .
densho:edge a owl:ObjectProperty ;
	rdfs:label "edge" ;
	rdfs:range densho:GovernedEntity ;
	skos:definition "A typed relationship from a node to a node or a directive." ;
	skos:inScheme densho:metamodel .
densho:exceptions a owl:ObjectProperty ;
	rdfs:label "exceptions" ;
	rdfs:range densho:DirectiveException ;
	skos:definition "The inherited directives that stop at this node." ;
	skos:inScheme densho:metamodel .
densho:governs a owl:ObjectProperty ;
	rdfs:label "governs" ;
	rdfs:range densho:Node ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The nodes that this node sets rules for. A governance node can name itself." ;
	skos:inScheme densho:metamodel .
densho:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	rdfs:range _:c14n4 ;
	skos:definition "The stable identifier. The identifier does not change when a file moves." ;
	skos:inScheme densho:metamodel .
densho:implements a owl:ObjectProperty ;
	rdfs:label "implements" ;
	rdfs:range skos:Concept ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The domain nodes that this workspace node gives project values for." ;
	skos:inScheme densho:metamodel .
densho:informs a owl:ObjectProperty ;
	rdfs:label "informs" ;
	rdfs:range skos:Concept ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The nodes that take the output of this node as an input. This edge is the flow from one step to the next." ;
	skos:inScheme densho:metamodel .
densho:invocation a owl:ObjectProperty ;
	rdfs:label "invocation" ;
	rdfs:range densho:Invocation ;
	skos:definition "The actor that starts the skill." ;
	skos:inScheme densho:metamodel .
densho:knowledge_type a owl:ObjectProperty ;
	rdfs:label "knowledge_type" ;
	rdfs:range densho:KnowledgeType ;
	skos:definition "The kind of knowledge in the node." ;
	skos:inScheme densho:metamodel .
densho:metamodel.owl.ttl dcterms:title "Densho metamodel" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "metamodel" ;
	skos:definition "This schema defines what can exist in the knowledge graph." .
densho:nodes a owl:ObjectProperty ;
	rdfs:label "nodes" ;
	rdfs:range densho:KnowledgeNode ;
	skos:definition "The knowledge nodes of the graph." ;
	skos:inScheme densho:metamodel .
densho:origin a owl:ObjectProperty ;
	rdfs:label "origin" ;
	rdfs:range densho:Origin ;
	skos:definition "The source of the entity in this repository." ;
	skos:inScheme densho:metamodel .
densho:paths a owl:DatatypeProperty ;
	rdfs:label "paths" ;
	rdfs:range _:c14n5 ;
	skos:definition "The file patterns that load the target." ;
	skos:inScheme densho:metamodel .
densho:pointers a owl:ObjectProperty ;
	rdfs:label "pointers" ;
	rdfs:range densho:Pointer ;
	skos:definition "The routes from this node to other nodes." ;
	skos:inScheme densho:metamodel .
densho:reason a owl:DatatypeProperty ;
	rdfs:label "reason" ;
	rdfs:range _:c14n43 ;
	skos:definition "The reason that the directive does not apply at this node." ;
	skos:inScheme densho:metamodel .
densho:refines a owl:ObjectProperty ;
	rdfs:label "refines" ;
	rdfs:range densho:Directive ;
	skos:definition "The broader directives that this directive makes more specific. Both directives apply." ;
	skos:inScheme densho:metamodel .
densho:rejection_reason a owl:DatatypeProperty ;
	rdfs:label "rejection_reason" ;
	rdfs:range _:c14n70 ;
	skos:definition "The reason that a person rejected the entity." ;
	skos:inScheme densho:metamodel .
densho:result a owl:ObjectProperty ;
	rdfs:label "result" ;
	rdfs:range densho:CompiledResult ;
	skos:definition "The directives that a compiled graph holds. A source graph has no value." ;
	skos:inScheme densho:metamodel .
densho:root a owl:ObjectProperty ;
	rdfs:label "root" ;
	rdfs:range densho:Root ;
	skos:definition "The top node of the graph." ;
	skos:inScheme densho:metamodel .
densho:scope a owl:ObjectProperty ;
	rdfs:label "scope" ;
	rdfs:range densho:DirectiveScope ;
	skos:definition "The nodes that the directive applies to. This field has no default, because inheritance is explicit." ;
	skos:inScheme densho:metamodel .
densho:status a owl:ObjectProperty ;
	rdfs:label "status" ;
	rdfs:range densho:Status ;
	skos:definition "The lifecycle state." ;
	skos:inScheme densho:metamodel .
densho:target a owl:ObjectProperty ;
	rdfs:label "target" ;
	rdfs:range densho:Node ;
	skos:definition "The node that the pointer routes to." ;
	skos:inScheme densho:metamodel .
densho:text a owl:DatatypeProperty ;
	rdfs:label "text" ;
	rdfs:range _:c14n95 ;
	skos:definition "The instruction." ;
	skos:inScheme densho:metamodel .
densho:trigger a owl:DatatypeProperty ;
	rdfs:label "trigger" ;
	rdfs:range _:c14n79 ;
	skos:definition "The condition that tells an agent to follow the pointer." ;
	skos:inScheme densho:metamodel .
densho:uses a owl:ObjectProperty ;
	rdfs:label "uses" ;
	rdfs:range skos:Concept ;
	rdfs:subPropertyOf densho:edge ;
	skos:definition "The knowledge that the skill composes." ;
	skos:inScheme densho:metamodel .
