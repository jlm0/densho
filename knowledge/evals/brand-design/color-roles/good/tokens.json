{
  "palette": {
    "green-700": { "$type": "color", "$value": "#2f6b3a" },
    "green-200": { "$type": "color", "$value": "#b7dfc0" },
    "stone-50": { "$type": "color", "$value": "#f7f6f2" },
    "stone-900": { "$type": "color", "$value": "#1d1c19" },
    "white": { "$type": "color", "$value": "#ffffff" },
    "black": { "$type": "color", "$value": "#000000" },
    "red-700": { "$type": "color", "$value": "#b3261e" },
    "red-200": { "$type": "color", "$value": "#f2b8b5" }
  },
  "role": {
    "light": {
      "primary": { "$type": "color", "$value": "{palette.green-700}" },
      "on-primary": { "$type": "color", "$value": "{palette.white}" },
      "surface": { "$type": "color", "$value": "{palette.stone-50}" },
      "on-surface": { "$type": "color", "$value": "{palette.stone-900}" },
      "error": { "$type": "color", "$value": "{palette.red-700}" }
    },
    "dark": {
      "primary": { "$type": "color", "$value": "{palette.green-200}" },
      "on-primary": { "$type": "color", "$value": "{palette.black}" },
      "surface": { "$type": "color", "$value": "{palette.stone-900}" },
      "on-surface": { "$type": "color", "$value": "{palette.stone-50}" },
      "error": { "$type": "color", "$value": "{palette.red-200}" }
    }
  }
}
